/*afficher les commandes avec le nom du client et le statut dela commande*/
select 'clients' as nom_table, count(*) from clients c
union ALL
select 'commandes', count(*) from commandes co
union ALL
select 'lignes_commandes' , count(*) from lignes_commande lc
union ALL
select 'produits', count(*) from produits p;

/*afficher tout les clients de lomé*/

select * from clients
 where ville = 'Lomé'
 order by nom_complet asc;


/*afficher les produits dont le prix est inferieur à 1500 du moins cher au plus cher*/

SELECT * from produits WHERE prix_unitaire < 1500
order BY prix_unitaire ASC;

/*afficher les commandes livres des plus recentes aux plus anciennes*/

select * from commandes WHERE statut = 'Livrée'
order by date_commande DESC;

/*afficher les produits de categorie 'fruits' ou 'ceréales'*/

SELECT * from produits
 WHERE categorie IN ('Fruits', 'Céréales');

/*afficher les commandes passées entre le 25 juin et le 3 juillet 2025*/

select * from commandes
where date_commande between '2025-06-25' and '2025-07-03';

/*compter le nombre de clientes inscrits dans chaque ville*/

select ville, count(*) as nombre_clients from clients
group by ville
order by nombre_clients desc;

/*calculer le prix moyen des produirs par categorie */

select categorie, avg(prix_unitaire) as prix_moyen
from produits
group by categorie;

/*trouver le prix le plus élevé et le plus bas du catalogue */

select max(prix_unitaire) as prix_max, min(prix_unitaire) as prix_min 
from produits
group by categorie;

/*Calcule de la valeur du stock de chaque produit (`prix_unitaire × stock`). Donnez un alias français à la colonne calculée*/

select nom_produit, sum(prix_unitaire*stock) as valeur_stock
from produits
group by nom_produit


/* compter les commandes selon leur statut*/

select statut, count(*) as nombre_commandes
from commandes
group by statut
order by nombre_commandes desc;

/* afficher les commandes avec le nom du clients et sa ville*/

select co.id_commande, c.nom_complet, c.ville, co.date_commande
from commandes co
join clients c on co.id_client = c.id_client
order by co.date_commande desc;

/*afficher le détail de chaque ligne : commande, produit, quantité et prix de vente*/

select lc.id_ligne, co.id_commande, p.nom_produit, lc.quantite, lc.prix_vente
from lignes_commande lc
join commandes co on lc.id_commande = co.id_commande
join produits p on lc.id_produit = p.id_produit
order by co.date_commande desc;

/*Calcule du  le total de chaque commande (`quantite × prix_vente`)*/

select co.id_commande, sum(quantite * prix_vente) as total_commande
from lignes_commande lc
join commandes co on lc.id_commande = co.id_commande
group by co.id_commande
 ORDER BY total_commande desc;

 /* calcule de chiffre d'affaires total des commandes livrées uniquement*/

 /*Trouvez les produits les plus vendus en quantité*/

 select p.nom_produit, sum(lc.quantite) as total_quantite
 from lignes_commande lc
    join produits p on lc.id_produit = p.id_produit
    group by p.nom_produit
    order by total_quantite desc
    limit 5;

 /*Trouvez le montant total dépensé par chaque client, du plus grand au plus petit*/

 select c.nom_complet, sum(lc.quantite * lc.prix_vente) as total_dépensé
 from clients c
 left join commandes co on c.id_client = co.id_client
 left join lignes_commande lc on co.id_commande = lc.id_commande
 group by c.nom_complet
 order by total_dépensé desc;

 /*Affichez les commandes dont le total dépasse 5 000 FCFA*/

 select co.id_commande, sum(lc.quantite * lc.prix_vente) as total_commande
 from lignes_commande lc
 join commandes co on lc.id_commande = co.id_commande
 group by co.id_commande
 having sum(lc.quantite * lc.prix_vente) > 5000
 order by total_commande desc;

/*nombre moyen d'articles par commande (Additionnez les quantités par commande, puis calculez la moyenne*/

select co.id_commande, avg(lc.quantite) as moyenne_quantite
from lignes_commande lc
join commandes co on lc.id_commande = co.id_commande
group by co.id_commande;
